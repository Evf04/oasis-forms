---
import "../styles/global.scss";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "OASIS | Adidas",
  description = "Registrá tu ticket de compra de adidas Originals Malabia o Unicenter para validar tu acceso a la colección exclusiva.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="icon" type="image/svg+xml" href="/images/adidas.svg" />
    <link rel="apple-touch-icon" href="/images/adidas.svg" />

    <!-- Preload Campaign Fonts (Eliminates FOUT / Font Flicker) -->
    <link
      rel="preload"
      href="/fonts/adidasFG-CompressedBold.ttf"
      as="font"
      type="font/ttf"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/Arial.ttf"
      as="font"
      type="font/ttf"
      crossorigin="anonymous"
    />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
