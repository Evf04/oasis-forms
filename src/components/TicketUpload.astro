---
// src/components/TicketUpload.astro
---

<div class="ticket-upload-container">
  <div class="upload-header">
    <label for="ticket-input" class="upload-label">
      CARGÁ TU TICKET DE COMPRA
    </label>
    <p class="upload-hint">Subí una foto nítida de tu comprobante o tomá una captura directa</p>
  </div>

  <div class="upload-dropzone" id="ticket-dropzone">
    <!-- Hidden inputs for file upload / camera capture -->
    <input
      type="file"
      id="ticket-input"
      name="ticket"
      accept=".jpg,.jpeg,.png,.webp,.pdf,image/jpeg,image/png,image/webp,application/pdf"
      required
      class="file-input-hidden"
    />
    <input
      type="file"
      id="camera-input"
      accept="image/jpeg,image/png,image/webp"
      capture="environment"
      class="file-input-hidden"
    />

    <!-- Empty State / Default UI -->
    <div class="upload-empty-state" id="upload-empty-state">
      <div class="upload-icon-wrapper">
        <svg class="upload-icon" viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="17 8 12 3 7 8"></polyline>
          <line x1="12" y1="3" x2="12" y2="15"></line>
        </svg>
      </div>

      <p class="upload-main-text">Arrastrá tu ticket aquí o elegí una opción:</p>

      <div class="upload-actions">
        <button type="button" class="btn-action btn-browse" id="btn-browse">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
          </svg>
          <span>Subir archivo</span>
        </button>

        <button type="button" class="btn-action btn-camera" id="btn-camera">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
            <circle cx="12" cy="13" r="4"></circle>
          </svg>
          <span>Abrir cámara</span>
        </button>
      </div>
    </div>

    <!-- Preview State UI (shown when file selected) -->
    <div class="upload-preview-state" id="upload-preview-state" style="display: none;">
      <div class="preview-card">
        <div class="preview-thumbnail" id="preview-thumbnail-container">
          <div id="preview-media-slot"></div>
        </div>

        <div class="preview-info">
          <div class="preview-status">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#22c55e" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span class="preview-status-text">Ticket cargado correctamente</span>
          </div>
          <span class="preview-filename" id="preview-filename">ticket_compra.jpg</span>
          <span class="preview-filesize" id="preview-filesize">1.4 MB</span>
        </div>

        <button type="button" class="btn-remove-file" id="btn-remove-file" title="Eliminar archivo" aria-label="Eliminar archivo cargado">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Error feedback message (hidden by default) -->
  <p class="upload-error-msg" id="upload-error-msg" style="display: none;" role="alert"></p>
</div>

<style>
  .ticket-upload-container {
    width: 100%;
    margin-bottom: clamp(2rem, 4.5vw, 3rem);
  }

  .upload-header {
    margin-bottom: 1rem;
  }

  .upload-label {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.2vw, 1.3rem);
    letter-spacing: 0.03em;
    color: var(--text-primary);
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }

  .upload-hint {
    font-size: clamp(0.85rem, 1.6vw, 0.95rem);
    color: var(--text-secondary);
  }

  .upload-dropzone {
    border: 2px dashed #666666;
    border-radius: var(--radius-md);
    background-color: #000000;
    padding: clamp(2rem, 4vw, 3rem) clamp(1.25rem, 3.5vw, 2.25rem);
    text-align: center;
    transition: all var(--transition-normal);
    position: relative;
  }

  @media (hover: hover) and (pointer: fine) {
    .upload-dropzone:hover {
      border-color: #aaaaaa;
      background-color: #080808;
    }
  }

  .upload-dropzone.dragover {
    border-color: #ffffff;
    background-color: #111111;
  }

  .file-input-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .upload-empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .upload-icon-wrapper {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #111111;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-primary);
    border: 1.5px solid #444444;
  }

  .upload-main-text {
    font-size: clamp(0.92rem, 1.8vw, 1.05rem);
    color: var(--text-secondary);
  }

  .upload-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    width: 100%;
    max-width: 460px;
    margin: 0.5rem 0;
  }

  .btn-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    min-height: 52px;
    padding: 0.85rem 1.65rem;
    border-radius: var(--radius-md);
    font-size: clamp(1rem, 2vw, 1.12rem);
    font-family: var(--font-display);
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: all var(--transition-fast);
    flex: 1;
    min-width: 160px;
  }

  .btn-browse {
    background-color: #ffffff;
    color: #000000;
    border: 1.75px solid #ffffff;
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-browse:hover {
      background-color: #e0e0e0;
      transform: translateY(-1px);
    }
  }

  .btn-camera {
    background-color: #111111;
    color: #ffffff;
    border: 1.75px solid #666666;
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-camera:hover {
      background-color: #222222;
      border-color: #aaaaaa;
      transform: translateY(-1px);
    }
  }

  .upload-error-msg {
    color: #ff5555;
    font-size: 0.85rem;
    margin-top: 0.65rem;
    text-align: center;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  /* Preview Styles */
  .preview-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: #0d0d0d;
    border: 1.75px solid #444444;
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    text-align: left;
  }

  .preview-thumbnail {
    width: 70px;
    height: 70px;
    border-radius: 4px;
    overflow: hidden;
    background: #000000;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #222222;
  }

  :global(.preview-img-element) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .preview-info {
    flex-grow: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .preview-status {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .preview-status-text {
    font-size: 0.85rem;
    font-weight: 700;
    color: #22c55e;
    letter-spacing: 0.02em;
  }

  .preview-filename {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .preview-filesize {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .btn-remove-file {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    min-width: var(--min-touch-target);
    min-height: var(--min-touch-target);
    padding: 0.6rem;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-remove-file:hover {
      background: #242424;
      color: #ff5555;
    }
  }

  @media (max-width: 480px) {
    .upload-actions {
      flex-direction: column;
    }
    .btn-action {
      width: 100%;
      min-width: unset;
    }
    .preview-card {
      padding: 0.85rem;
      gap: 0.85rem;
    }
    .preview-thumbnail {
      width: 56px;
      height: 56px;
    }
  }
</style>

<script>
  // Ticket file upload & camera preview logic with 3MB & format validation
  function setupUpload() {
    const fileInput = document.getElementById('ticket-input') as HTMLInputElement | null;
    const cameraInput = document.getElementById('camera-input') as HTMLInputElement | null;
    const btnBrowse = document.getElementById('btn-browse');
    const btnCamera = document.getElementById('btn-camera');
    const dropzone = document.getElementById('ticket-dropzone');
    const emptyState = document.getElementById('upload-empty-state');
    const previewState = document.getElementById('upload-preview-state');
    const mediaSlot = document.getElementById('preview-media-slot');
    const previewName = document.getElementById('preview-filename');
    const previewSize = document.getElementById('preview-filesize');
    const btnRemove = document.getElementById('btn-remove-file');
    const errorMsg = document.getElementById('upload-error-msg');

    if (!fileInput || !emptyState || !previewState || !mediaSlot) return;

    const MAX_FILE_SIZE = 15 * 1024 * 1024; // 15 MB
    const ALLOWED_EXTENSIONS = ['.jpg', '.jpeg', '.png', '.webp', '.pdf'];
    const ALLOWED_MIME_TYPES = ['image/jpeg', 'image/png', 'image/webp', 'application/pdf'];

    function showError(message: string) {
      if (errorMsg) {
        errorMsg.textContent = message;
        errorMsg.style.display = 'block';
      }
    }

    function clearError() {
      if (errorMsg) {
        errorMsg.textContent = '';
        errorMsg.style.display = 'none';
      }
    }

    btnBrowse?.addEventListener('click', () => {
      fileInput.click();
    });

    btnCamera?.addEventListener('click', () => {
      cameraInput?.click();
    });

    function handleFile(file: File) {
      if (!file) return;

      clearError();

      // Check file extension / format
      const fileNameLower = file.name.toLowerCase();
      const hasValidExt = ALLOWED_EXTENSIONS.some(ext => fileNameLower.endsWith(ext));
      const hasValidMime = ALLOWED_MIME_TYPES.includes(file.type);

      if (!hasValidExt && !hasValidMime) {
        showError('Formato no válido. Solo se permiten imágenes JPG, PNG, WEBP o documentos PDF.');
        fileInput.value = '';
        if (cameraInput) cameraInput.value = '';
        window.dispatchEvent(new CustomEvent('ticket-validated', { detail: { valid: false } }));
        return;
      }

      // Check file size (must be <= 15MB)
      if (file.size > MAX_FILE_SIZE) {
        showError('El archivo supera el tamaño máximo permitido de 15MB.');
        fileInput.value = '';
        if (cameraInput) cameraInput.value = '';
        window.dispatchEvent(new CustomEvent('ticket-validated', { detail: { valid: false } }));
        return;
      }

      // Assign to main file input if needed
      if (fileInput && fileInput.files && fileInput.files[0] !== file) {
        const dataTransfer = new DataTransfer();
        dataTransfer.items.add(file);
        fileInput.files = dataTransfer.files;
      }

      if (previewName) previewName.textContent = file.name;
      if (previewSize) {
        const sizeMb = (file.size / (1024 * 1024)).toFixed(2);
        previewSize.textContent = `${sizeMb} MB`;
      }

      if (file.type.startsWith('image/')) {
        const reader = new FileReader();
        reader.onload = (e) => {
          if (mediaSlot && e.target?.result) {
            mediaSlot.innerHTML = `<img src="${e.target.result}" alt="Vista previa del ticket" class="preview-img-element" />`;
          }
        };
        reader.readAsDataURL(file);
      } else {
        if (mediaSlot) {
          mediaSlot.innerHTML = `
            <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="#888888" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
          `;
        }
      }

      emptyState.style.display = 'none';
      previewState.style.display = 'block';

      // Notify form validator
      window.dispatchEvent(new CustomEvent('ticket-validated', { detail: { valid: true } }));
    }

    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files[0]) {
        handleFile(fileInput.files[0]);
      }
    });

    cameraInput?.addEventListener('change', () => {
      if (cameraInput.files && cameraInput.files[0]) {
        handleFile(cameraInput.files[0]);
      }
    });

    btnRemove?.addEventListener('click', () => {
      fileInput.value = '';
      if (cameraInput) cameraInput.value = '';
      clearError();
      emptyState.style.display = 'flex';
      previewState.style.display = 'none';
      if (mediaSlot) mediaSlot.innerHTML = '';
      window.dispatchEvent(new CustomEvent('ticket-validated', { detail: { valid: false } }));
    });

    // Drag and drop
    dropzone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('dragover');
    });

    dropzone?.addEventListener('dragleave', () => {
      dropzone.classList.remove('dragover');
    });

    dropzone?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('dragover');
      if (e.dataTransfer?.files && e.dataTransfer.files[0]) {
        handleFile(e.dataTransfer.files[0]);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupUpload);
  } else {
    setupUpload();
  }
</script>
