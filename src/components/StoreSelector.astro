---
// src/components/StoreSelector.astro
---

<div class="store-selector-container">
  <div class="section-title-wrap">
    <h3 class="section-title">ELEGÍ TU TIENDA</h3>
    <p class="section-note">*Seleccioná la sucursal correspondiente a tu compra</p>
  </div>

  <div class="store-grid">
    <!-- Store 1: Malabia -->
    <label class="store-card" for="store-malabia">
      <input
        type="radio"
        id="store-malabia"
        name="tienda"
        value="malabia"
        required
        class="store-radio sr-only"
      />
      <div class="store-card-inner">
        <div class="store-header">
          <span class="store-badge">ORIGINALS</span>
          <div class="radio-indicator" aria-hidden="true">
            <svg class="check-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
        </div>
        <h4 class="store-name">MALABIA</h4>
        <div class="store-details">
          <p class="store-address">
            <svg class="icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            Malabia 1720, CABA
          </p>
        </div>
      </div>
    </label>

    <!-- Store 2: Unicenter -->
    <label class="store-card" for="store-unicenter">
      <input
        type="radio"
        id="store-unicenter"
        name="tienda"
        value="unicenter"
        required
        class="store-radio sr-only"
      />
      <div class="store-card-inner">
        <div class="store-header">
          <span class="store-badge">ORIGINALS</span>
          <div class="radio-indicator" aria-hidden="true">
            <svg class="check-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
        </div>
        <h4 class="store-name">UNICENTER</h4>
        <div class="store-details">
          <p class="store-address">
            <svg class="icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            Paraná 3745, Martínez - Bs As
          </p>
        </div>
      </div>
    </label>
  </div>
</div>

<style>
  .store-selector-container {
    width: 100%;
    margin-bottom: clamp(2rem, 4.5vw, 3rem);
  }

  .section-title-wrap {
    text-align: center;
    margin-bottom: clamp(1.25rem, 3vw, 1.85rem);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3vw, 1.85rem);
    letter-spacing: 0.03em;
    color: var(--text-primary);
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }

  .section-note {
    font-size: clamp(0.85rem, 1.8vw, 0.96rem);
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  .store-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .store-card {
    display: block;
    position: relative;
    cursor: pointer;
    min-height: var(--min-touch-target);
  }

  .store-card-inner {
    background-color: #000000;
    border: 1.75px solid #666666;
    border-radius: var(--radius-md);
    padding: clamp(1.35rem, 3vw, 1.85rem) clamp(1.25rem, 2.8vw, 1.75rem);
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: all var(--transition-normal);
    position: relative;
  }

  @media (hover: hover) and (pointer: fine) {
    .store-card:hover .store-card-inner {
      border-color: #aaaaaa;
      background-color: #080808;
      transform: translateY(-2px);
    }
  }

  .store-radio:focus-visible + .store-card-inner {
    outline: 2px solid var(--accent-white);
    outline-offset: 2px;
  }

  .store-radio:checked + .store-card-inner {
    border-color: var(--text-primary);
    background-color: #111111;
    box-shadow: 0 0 0 1px var(--text-primary), 0 8px 24px rgba(0, 0, 0, 0.6);
  }

  .store-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
  }

  .store-badge {
    font-family: var(--font-display);
    font-size: clamp(0.78rem, 1.5vw, 0.9rem);
    letter-spacing: 0.05em;
    color: var(--text-secondary);
  }

  .radio-indicator {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 2px solid #666666;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    transition: all var(--transition-fast);
    flex-shrink: 0;
  }

  .check-icon {
    display: none;
    color: #000000;
  }

  .store-radio:checked + .store-card-inner .radio-indicator {
    border-color: #ffffff;
    background-color: #ffffff;
  }

  .store-radio:checked + .store-card-inner .check-icon {
    display: block;
  }

  .store-name {
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3.5vw, 2.25rem);
    letter-spacing: 0.02em;
    color: var(--text-primary);
    margin-bottom: 0.85rem;
  }

  .store-details {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: auto;
  }

  .store-address {
    font-size: clamp(0.92rem, 1.8vw, 1.05rem);
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 0.55rem;
    line-height: 1.4;
  }

  .icon {
    flex-shrink: 0;
    opacity: 0.8;
  }

  @media (max-width: 540px) {
    .store-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
