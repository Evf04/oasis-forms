---
import Layout from "../layouts/Layout.astro";
import Form from "../components/Form.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<Layout
  title="adidas Originals x Oasis | Carga de Ticket"
  description="Registrá tu ticket de compra de adidas Originals Malabia o Unicenter para validar tu acceso a la colección exclusiva."
>
  <main class="main-content">
    <Form />
  </main>
  <Footer />
</Layout>

<style>
  .main-content {
    width: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: clamp(0.75rem, 2vw, 1.5rem);
  }
</style>
