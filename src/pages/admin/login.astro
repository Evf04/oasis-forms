---
// src/pages/admin/login.astro
import Layout from "../../layouts/Layout.astro";
---

<Layout title="OASIS | Admin Login" description="Acceso al panel de administración de tickets OASIS | Adidas">
  <main class="main-content">
    <div class="campaign-wrapper">
      <!-- Top Brand Logos Banner -->
      <div class="top-logos-banner">
        <div class="logo-item adidas-wrap">
          <img
            src="/images/adidas.svg"
            alt="adidas Originals"
            width="240"
            height="165"
            class="brand-logo-img adidas-logo"
            loading="eager"
          />
        </div>
        <div class="logo-divider" aria-hidden="true"></div>
        <div class="logo-item oasis-wrap">
          <img
            src="/images/oasis.svg"
            alt="Oasis"
            width="370"
            height="148"
            class="brand-logo-img oasis-logo"
            loading="eager"
          />
        </div>
      </div>

      <!-- Login Form Section -->
      <div class="form-section login-card-container">
        <div class="section-title-wrap">
          <h1 class="section-title">INICIAR SESIÓN</h1>
        </div>

        <form id="admin-login-form" class="main-form" autocomplete="off">
          <!-- Dynamic Error Text (Red text only, no box) -->
          <div class="error-banner" id="error-banner" style="display: none;" role="alert">
            <span id="error-text" class="error-text">Usuario o contraseña incorrectos.</span>
          </div>

          <div class="login-inputs-grid">
            <!-- Username -->
            <div class="form-group">
              <label for="admin-user" class="form-label">Usuario</label>
              <input
                type="text"
                id="admin-user"
                name="username"
                required
                placeholder="Usuario"
                class="form-input"
                autocomplete="username"
              />
            </div>

            <!-- Password -->
            <div class="form-group">
              <label for="admin-pass" class="form-label">Contraseña</label>
              <div class="password-wrapper">
                <input
                  type="password"
                  id="admin-pass"
                  name="password"
                  required
                  placeholder="Contraseña"
                  class="form-input"
                  autocomplete="current-password"
                />
                <button
                  type="button"
                  id="toggle-password"
                  class="btn-toggle-password"
                  title="Mostrar u ocultar contraseña"
                  aria-label="Mostrar u ocultar contraseña"
                >
                  <svg id="eye-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- Submission Section -->
          <div class="submission-section">
            <button type="submit" class="btn-submit" id="btn-login">
              <span>INGRESAR AL PANEL</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>
</Layout>

<style>
  .main-content {
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding-top: clamp(0.75rem, 2vw, 1.5rem);
    padding-bottom: clamp(2.5rem, 6vw, 5rem);
  }

  .campaign-wrapper {
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 3.5vw, 2rem);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Top Brand Logos Banner - Fluid scaling matching main page */
  .top-logos-banner {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1.25rem, 4vw, 4.5rem);
    padding: clamp(1.5rem, 4vw, 4.5rem) 0.5rem clamp(2rem, 5vw, 4.5rem);
  }

  .logo-item {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 1;
  }

  .brand-logo-img {
    height: auto;
    object-fit: contain;
    display: block;
    max-width: 100%;
    transition: transform var(--transition-normal);
  }

  @media (hover: hover) and (pointer: fine) {
    .brand-logo-img:hover {
      transform: scale(1.03);
    }
  }

  .adidas-logo {
    width: clamp(80px, 17vw, 230px);
  }

  .oasis-logo {
    width: clamp(125px, 26.5vw, 360px);
  }

  .logo-divider {
    width: clamp(3.5px, 0.38vw, 5px);
    height: clamp(56px, 12vw, 163px);
    background-color: #ffffff;
    opacity: 1;
    flex-shrink: 0;
  }

  /* Login Section Form */
  .form-section {
    width: 100%;
    margin-bottom: clamp(2rem, 4.5vw, 3.5rem);
  }

  .login-card-container {
    max-width: 560px;
    margin: 0 auto;
  }

  .section-title-wrap {
    text-align: center;
    margin-bottom: clamp(1.25rem, 3vw, 1.85rem);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3vw, 1.85rem);
    letter-spacing: 0.03em;
    color: var(--text-primary);
    text-transform: uppercase;
  }

  .main-form {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .login-inputs-grid {
    display: flex;
    flex-direction: column;
    gap: clamp(1.15rem, 2.5vw, 1.5rem);
    width: 100%;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    width: 100%;
  }

  .form-label {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    letter-spacing: 0.03em;
    color: var(--text-primary);
    text-transform: uppercase;
  }

  .form-input {
    width: 100%;
    background-color: #000000;
    border: 2.5px solid #777777;
    border-radius: var(--radius-md);
    padding: 0.95rem 1.15rem;
    min-height: 56px;
    font-size: 1.05rem;
    color: var(--text-primary);
    transition: all var(--transition-fast);
  }

  .form-input::placeholder {
    color: #888888;
    font-family: var(--font-sans);
    font-size: 0.98rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .form-input:hover {
      border-color: #bbbbbb;
    }
  }

  .form-input:focus {
    border-color: var(--accent-white);
    background-color: #000000;
    box-shadow: 0 0 0 1.5px var(--accent-white);
    outline: none;
  }

  .password-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .password-wrapper .form-input {
    padding-right: 3.5rem;
  }

  .btn-toggle-password {
    position: absolute;
    right: 0.85rem;
    background: transparent;
    border: none;
    color: #888888;
    cursor: pointer;
    min-width: var(--min-touch-target);
    min-height: var(--min-touch-target);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transition: color var(--transition-fast);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-toggle-password:hover {
      color: #ffffff;
    }
  }

  .error-banner {
    display: block;
    text-align: center;
    margin: 0 0 0.75rem 0;
    animation: shake 0.3s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
  }

  @keyframes shake {
    10%, 90% { transform: translate3d(-1px, 0, 0); }
    20%, 80% { transform: translate3d(2px, 0, 0); }
    30%, 50%, 70% { transform: translate3d(-3px, 0, 0); }
    40%, 60% { transform: translate3d(3px, 0, 0); }
  }

  .error-text {
    color: #ff4d4f;
    font-size: 0.95rem;
    line-height: 1.4;
    font-weight: 500;
    text-align: center;
    display: block;
  }

  .submission-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 1.5rem;
    width: 100%;
  }

  .btn-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    background-color: var(--accent-white);
    color: var(--text-inverted);
    border: none;
    border-radius: var(--radius-md);
    min-height: 56px;
    padding: 1.15rem clamp(2.5rem, 6vw, 4.5rem);
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.2vw, 1.35rem);
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: all var(--transition-normal);
    box-shadow: 0 4px 24px rgba(255, 255, 255, 0.18);
    width: 100%;
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-submit:hover {
      background-color: #e5e5e5;
      transform: translateY(-2px);
      box-shadow: 0 8px 32px rgba(255, 255, 255, 0.3);
    }
  }

  .btn-submit:active {
    transform: scale(0.98);
  }

  .btn-submit:disabled {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>

<script>
  function setupLogin() {
    const form = document.getElementById('admin-login-form') as HTMLFormElement | null;
    const userInput = document.getElementById('admin-user') as HTMLInputElement | null;
    const passInput = document.getElementById('admin-pass') as HTMLInputElement | null;
    const btnSubmit = document.getElementById('btn-login') as HTMLButtonElement | null;
    const errorBanner = document.getElementById('error-banner');
    const errorText = document.getElementById('error-text');
    const togglePassBtn = document.getElementById('toggle-password');
    const eyeIcon = document.getElementById('eye-icon');

    if (!form || !userInput || !passInput || !btnSubmit) return;

    // Check if already authenticated
    if (sessionStorage.getItem('oasis_admin_authenticated') === 'true') {
      window.location.href = '/admin/dashboard';
      return;
    }

    // Toggle password visibility
    togglePassBtn?.addEventListener('click', () => {
      if (passInput.type === 'password') {
        passInput.type = 'text';
        if (eyeIcon) {
          eyeIcon.innerHTML = `
            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
            <line x1="1" y1="1" x2="23" y2="23"></line>
          `;
        }
      } else {
        passInput.type = 'password';
        if (eyeIcon) {
          eyeIcon.innerHTML = `
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          `;
        }
      }
    });

    function showError(msg: string) {
      if (errorBanner && errorText) {
        errorText.textContent = msg;
        errorBanner.style.display = 'block';
      }
    }

    function hideError() {
      if (errorBanner) {
        errorBanner.style.display = 'none';
      }
    }

    userInput.addEventListener('input', hideError);
    passInput.addEventListener('input', hideError);

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      hideError();

      const enteredUser = userInput.value.trim();
      const enteredPass = passInput.value;

      // Expected credentials from environment
      const expectedUser = import.meta.env.PUBLIC_ADMIN_USER || 'admin';
      const expectedPass = import.meta.env.PUBLIC_ADMIN_PASS || 'oasis2025';

      btnSubmit.disabled = true;
      const originalHtml = btnSubmit.innerHTML;
      btnSubmit.innerHTML = `
        <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" fill="none" stroke-width="2.5" style="animation: spin 0.8s linear infinite;">
          <circle cx="12" cy="12" r="10" stroke-dasharray="32" stroke-dashoffset="12"></circle>
        </svg>
        <span>VERIFICANDO...</span>
      `;

      setTimeout(() => {
        if (enteredUser === expectedUser && enteredPass === expectedPass) {
          // Authentication successful
          sessionStorage.setItem('oasis_admin_authenticated', 'true');
          sessionStorage.setItem('oasis_admin_user', enteredUser);
          sessionStorage.setItem('oasis_admin_login_at', new Date().toISOString());

          window.location.href = '/admin/dashboard';
        } else {
          // Authentication failed
          btnSubmit.disabled = false;
          btnSubmit.innerHTML = originalHtml;
          showError('Usuario o contraseña incorrectos.');
          passInput.value = '';
          passInput.focus();
        }
      }, 350);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupLogin);
  } else {
    setupLogin();
  }
</script>
