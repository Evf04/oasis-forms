---
// src/pages/admin/dashboard.astro
import Layout from "../../layouts/Layout.astro";
---

<Layout title="OASIS | Admin Dashboard" description="Panel de gestión y validación de comprobantes OASIS | Adidas">
  <!-- Strict Authentication Guard - Blocks unauthenticated visitors before render -->
  <script is:inline>
    (function () {
      if (typeof window !== 'undefined') {
        const isAuth = sessionStorage.getItem('oasis_admin_authenticated');
        if (isAuth !== 'true') {
          window.location.replace('/admin/login');
        }
      }
    })();
  </script>

  <div class="dashboard-page" id="dashboard-app" style="display: none;">
    <!-- Top Navigation Bar -->
    <header class="dash-navbar">
      <div class="dash-nav-container">
        <div class="dash-brand">
          <img src="/images/adidas.svg" alt="adidas" width="60" height="42" class="dash-logo" />
          <span class="dash-logo-divider"></span>
          <img src="/images/oasis.svg" alt="Oasis" width="100" height="40" class="dash-logo" />
        </div>

        <div class="dash-user-controls">
          <button type="button" class="btn-logout" id="btn-logout" title="Cerrar sesión">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            <span>Cerrar Sesión</span>
          </button>
        </div>
      </div>
    </header>

    <main class="dash-main">
      <div class="dash-content-container">
        <!-- Dashboard Header & Stats -->
        <div class="dash-header">
          <div>
            <h1 class="dash-title">REGISTROS DE COMPROBANTES</h1>
          </div>

          <div class="header-actions">
            <button type="button" class="btn-tool btn-refresh" id="btn-refresh" title="Recargar lista de registros">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" id="refresh-icon">
                <path d="M23 4v6h-6"></path>
                <path d="M1 20v-6h6"></path>
                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
              </svg>
              <span>Actualizar</span>
            </button>
            <button type="button" class="btn-tool btn-export" id="btn-export" title="Exportar registros a archivo CSV">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Exportar CSV</span>
            </button>
          </div>
        </div>

        <!-- Metric KPI Cards -->
        <div class="metrics-grid">
          <div class="metric-card">
            <span class="metric-label">TOTAL REGISTROS</span>
            <span class="metric-value" id="stat-total">0</span>
          </div>
          <div class="metric-card">
            <span class="metric-label">ORIGINALS MALABIA</span>
            <span class="metric-value" id="stat-malabia">0</span>
          </div>
          <div class="metric-card">
            <span class="metric-label">ORIGINALS UNICENTER</span>
            <span class="metric-value" id="stat-unicenter">0</span>
          </div>
          <div class="metric-card metric-card-prohibited">
            <span class="metric-label">NO HABILITADOS</span>
            <span class="metric-value metric-value-red" id="stat-prohibidos">0</span>
          </div>
        </div>

        <!-- Filters and Search Toolbar -->
        <div class="toolbar">
          <div class="search-box">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" class="search-icon">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="text"
              id="search-input"
              placeholder="Buscar por Nombre, DNI, Teléfono o Email..."
              class="search-input"
            />
          </div>

          <div class="toolbar-filters">
            <div class="filter-group">
              <span class="filter-label">Tienda:</span>
              <div class="filter-buttons">
                <button type="button" class="btn-filter btn-filter-store active" data-store="all">TODAS</button>
                <button type="button" class="btn-filter btn-filter-store" data-store="malabia">MALABIA</button>
                <button type="button" class="btn-filter btn-filter-store" data-store="unicenter">UNICENTER</button>
              </div>
            </div>

            <div class="filter-group">
              <span class="filter-label">Ver:</span>
              <div class="filter-buttons">
                <button type="button" class="btn-filter btn-filter-status active" data-status="active">HABILITADOS</button>
                <button type="button" class="btn-filter btn-filter-status" data-status="prohibited">NO HABILITADOS</button>
                <button type="button" class="btn-filter btn-filter-status" data-status="all">TODOS</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Loading State -->
        <div class="loading-state" id="loading-state">
          <svg viewBox="0 0 24 24" width="32" height="32" stroke="currentColor" fill="none" stroke-width="2.5" class="spin-icon">
            <circle cx="12" cy="12" r="10" stroke-dasharray="32" stroke-dashoffset="12"></circle>
          </svg>
          <span>Cargando registros de la base de datos...</span>
        </div>

        <!-- Error State -->
        <div class="error-state" id="error-state" style="display: none;">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#ff4d4f" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <span id="error-msg-text">Ocurrió un error al consultar Supabase.</span>
          <button type="button" class="btn-retry" id="btn-retry">Reintentar</button>
        </div>

        <!-- Empty State -->
        <div class="empty-state" id="empty-state" style="display: none;">
          <div class="empty-icon-wrap">
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
          </div>
          <h3>No se encontraron registros</h3>
          <p>Los tickets cargados por los usuarios aparecerán en esta tabla en tiempo real.</p>
        </div>

        <!-- Table Container -->
        <div class="table-container" id="table-container" style="display: none;">
          <table class="dash-table">
            <thead>
              <tr>
                <th>Fecha</th>
                <th>Tienda</th>
                <th>Titular</th>
                <th>DNI</th>
                <th>Contacto</th>
                <th>Comprobante</th>
                <th>Notas Admin</th>
                <th>Habilitación</th>
              </tr>
            </thead>
            <tbody id="table-body">
              <!-- Dynamically rendered -->
            </tbody>
          </table>
        </div>
      </div>
    </main>

    <!-- Ticket Viewer Modal -->
    <div class="modal-viewer" id="ticket-modal" style="display: none;" role="dialog" aria-modal="true">
      <div class="modal-viewer-backdrop" id="modal-ticket-backdrop"></div>
      <div class="modal-viewer-content">
        <div class="modal-viewer-header">
          <div>
            <h2 class="modal-viewer-title" id="ticket-modal-title">Comprobante de Compra</h2>
            <span class="modal-viewer-sub" id="ticket-modal-sub">Titular: -</span>
          </div>
          <button type="button" class="btn-modal-x" id="btn-ticket-modal-close" aria-label="Cerrar visor">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <div class="modal-viewer-body" id="ticket-viewer-slot">
          <!-- Dynamically populated with media element -->
        </div>

        <div class="modal-viewer-footer">
          <a href="#" target="_blank" rel="noopener noreferrer" class="btn-download" id="btn-ticket-download">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Abrir en tamaño original</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Ban / Unban Confirmation Modal -->
    <div class="modal-delete" id="ban-modal" style="display: none;" role="dialog" aria-modal="true">
      <div class="modal-delete-backdrop" id="modal-ban-backdrop"></div>
      <div class="modal-delete-card">
        <div class="delete-icon-wrap" id="ban-icon-wrap">
          <svg id="ban-icon-svg" viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="#ff4d4f" stroke-width="2.2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
          </svg>
        </div>
        <h3 class="delete-title" id="ban-modal-title">¿Deshabilitar este registro?</h3>
        <p class="delete-desc" id="ban-modal-desc">El usuario quedará marcado como NO HABILITADO y no podrá volver a registrarse.</p>
        <div class="delete-actions">
          <button type="button" class="btn-cancel" id="btn-cancel-ban">Cancelar</button>
          <button type="button" class="btn-confirm-delete" id="btn-confirm-ban">Confirmar Deshabilitación</button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style lang="scss">
  .dashboard-page {
    min-height: 100vh;
    min-height: 100dvh;
    width: 100%;
    max-width: 100vw;
    background-color: #000000;
    color: var(--text-primary);
    display: flex;
    flex-direction: column;
    overflow-x: clip;
  }

  /* Navbar */
  .dash-navbar {
    background-color: #000000;
    border-bottom: none;
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
  }

  .dash-nav-container {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    padding: clamp(0.85rem, 1.5vw, 1.35rem) clamp(1rem, 3.5vw, 3.5rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .dash-brand {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }

  .dash-logo {
    height: auto;
    object-fit: contain;
  }

  .dash-logo-divider {
    width: 2.5px;
    height: 28px;
    background-color: #ffffff;
    opacity: 0.9;
  }

  .dash-user-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .btn-logout {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: transparent;
    border: none;
    color: #ff4d4f;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    min-height: 46px;
    transition: all var(--transition-fast);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-logout:hover {
      background: rgba(255, 77, 79, 0.15);
      color: #ff7875;
    }
  }

  /* Main Container */
  .dash-main {
    flex-grow: 1;
    width: 100%;
    max-width: 100%;
    padding: clamp(1rem, 2.5vw, 2.5rem) clamp(1rem, 3.5vw, 3.5rem) clamp(2.5rem, 5vw, 5rem);
    background-color: #000000;
  }

  .dash-content-container {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
  }

  /* Header */
  .dash-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
  }

  .dash-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    letter-spacing: 0.04em;
    color: var(--text-primary);
    text-transform: uppercase;
    line-height: 1.1;
  }

  .header-actions {
    display: flex;
    gap: 0.85rem;
    align-items: center;
  }

  .btn-tool {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: #000000;
    border: 2px solid #555555;
    color: #ffffff;
    padding: 0.75rem 1.45rem;
    border-radius: var(--radius-md);
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    cursor: pointer;
    min-height: 48px;
    transition: all var(--transition-fast);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-tool:hover {
      background: #151515;
      border-color: #888888;
    }
  }

  .btn-export {
    background-color: var(--accent-white);
    color: var(--text-inverted);
    border: 2px solid var(--accent-white);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-export:hover {
      background-color: #e0e0e0;
    }
  }

  /* Metrics Grid */
  /* Metrics Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 2vw, 1.75rem);
    width: 100%;
  }

  .metric-card {
    background: #000000;
    border: 2.5px solid #444444;
    border-radius: var(--radius-md);
    padding: clamp(1.25rem, 2vw, 1.85rem) clamp(1rem, 1.8vw, 1.75rem);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    transition: border-color var(--transition-fast);
  }

  @media (hover: hover) and (pointer: fine) {
    .metric-card:hover {
      border-color: #666666;
    }
    .metric-card-prohibited:hover {
      border-color: rgba(255, 77, 79, 0.6);
    }
  }

  .metric-label {
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 1.2vw, 1.15rem);
    letter-spacing: 0.04em;
    color: var(--text-secondary);
  }

  .metric-value {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 3.5vw, 3.4rem);
    color: var(--text-primary);
    line-height: 1;
    font-weight: 700;
  }

  .metric-value-red {
    color: #ff4d4f;
  }

  /* Toolbar */
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    background: #000000;
    border: 2.5px solid #444444;
    border-radius: var(--radius-md);
    padding: clamp(0.85rem, 1.5vw, 1.25rem) clamp(1rem, 2vw, 1.75rem);
    width: 100%;
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1;
    min-width: clamp(260px, 30vw, 420px);
  }

  .search-icon {
    position: absolute;
    left: 1.15rem;
    color: #888888;
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    background: #000000;
    border: 2px solid #555555;
    border-radius: var(--radius-md);
    padding: 0.8rem 1.15rem 0.8rem 3rem;
    color: var(--text-primary);
    font-size: 1rem;
    min-height: 50px;
    transition: border-color var(--transition-fast);
  }

  .search-input:focus {
    border-color: var(--accent-white);
    outline: none;
    box-shadow: 0 0 0 1.5px var(--accent-white);
  }

  .toolbar-filters {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 1.75rem);
    flex-wrap: wrap;
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .filter-label {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--text-secondary);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .filter-buttons {
    display: flex;
    gap: 0.45rem;
  }

  .btn-filter {
    background: #000000;
    border: 2px solid #444444;
    color: #888888;
    padding: 0.55rem 1.15rem;
    border-radius: var(--radius-md);
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    cursor: pointer;
    min-height: 44px;
    transition: all var(--transition-fast);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-filter:hover {
      border-color: #777777;
      color: #ffffff;
    }
  }

  .btn-filter.active {
    background: #ffffff;
    color: #000000;
    border-color: #ffffff;
  }

  /* Table */
  .table-container {
    background: #000000;
    border: 2.5px solid #444444;
    border-radius: var(--radius-md);
    overflow-x: auto;
    width: 100%;
    -webkit-overflow-scrolling: touch;
  }

  .dash-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    min-width: 980px;
  }

  .dash-table th {
    background: #000000;
    color: #aaaaaa;
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    letter-spacing: 0.04em;
    padding: 1.15rem clamp(1rem, 1.6vw, 1.65rem);
    border-bottom: 2px solid #333333;
    text-transform: uppercase;
  }

  :global(.dash-table td) {
    padding: 1.15rem clamp(1rem, 1.6vw, 1.65rem);
    border-bottom: 1.5px solid #222222;
    font-size: clamp(0.92rem, 1.1vw, 1rem);
    vertical-align: middle;
  }

  :global(.store-badge-malabia) {
    display: inline-block;
    background: transparent;
    border: none;
    color: #60a5fa;
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    font-weight: 700;
    padding: 0;
  }

  :global(.store-badge-unicenter) {
    display: inline-block;
    background: transparent;
    border: none;
    color: #c084fc;
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    font-weight: 700;
    padding: 0;
  }

  :global(.cell-dni) {
    font-family: var(--font-display);
    font-size: 1.18rem;
    letter-spacing: 0.05em;
    color: var(--text-primary);
  }

  :global(.contact-phone) {
    font-family: var(--font-display);
    font-size: 1.08rem;
    letter-spacing: 0.04em;
    color: var(--text-primary);
  }

  :global(.contact-email) {
    font-size: 0.88rem;
    color: var(--text-secondary);
    font-family: var(--font-sans);
  }

  :global(.btn-view-ticket) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #000000;
    border: 2px solid #555555;
    color: #ffffff;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-md);
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    min-height: 40px;
    transition: all var(--transition-fast);
  }

  :global(.btn-view-ticket:hover) {
    background: #ffffff;
    color: #000000;
    border-color: #ffffff;
  }

  :global(.row-banned) {
    opacity: 0.65;
    background: rgba(255, 77, 79, 0.04);

    &:hover {
      opacity: 0.95;
      background: rgba(255, 77, 79, 0.08);
    }
  }

  :global(.btn-ban-toggle) {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 0.92rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    min-height: 38px;
    transition: all var(--transition-fast);
  }

  :global(.btn-ban) {
    background: transparent;
    border: none;
    color: #ff4d4f;

    &:hover {
      background: rgba(255, 77, 79, 0.15);
      color: #ff7875;
      transform: scale(1.03);
    }
  }

  :global(.btn-unban) {
    background: transparent;
    border: 1.5px solid #52c41a;
    color: #52c41a;

    &:hover {
      background: #52c41a;
      color: #000000;
      transform: scale(1.03);
    }
  }

  :global(.notes-input) {
    background: #000000;
    border: 2px solid #444444;
    border-radius: var(--radius-md);
    padding: 0.45rem 0.75rem;
    color: #cccccc;
    font-size: 0.88rem;
    width: 100%;
    min-width: 140px;
    max-width: 220px;
    min-height: 38px;
    transition: all var(--transition-fast);
  }

  :global(.notes-input:focus) {
    border-color: var(--accent-white);
    outline: none;
    color: #ffffff;
  }

  /* States */
  .loading-state, .error-state, .empty-state {
    background: #000000;
    border: 2.5px solid #444444;
    border-radius: var(--radius-md);
    padding: 4.5rem 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    color: var(--text-secondary);
    width: 100%;
  }

  .empty-icon-wrap {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: #141414;
    display: flex;
    align-items: center;
    justify-content: center;
