</style>

<script>
  import { getSupabaseClient } from '../../lib/supabase';

  interface Registration {
    id: string;
    tienda: 'malabia' | 'unicenter';
    nombre: string;
    dni: string;
    telefono: string;
    email: string;
    ticket_url: string;
    ticket_filename: string;
    ticket_size_bytes: number;
    admin_notes: string | null;
    is_banned?: boolean;
    created_at: string;
  }

  function initDashboard() {
    // 1. Guard check
    const isAuth = sessionStorage.getItem('oasis_admin_authenticated');
    if (isAuth !== 'true') {
      window.location.replace('/admin/login');
      return;
    }

    const app = document.getElementById('dashboard-app');
    if (app) app.style.display = 'flex';

    const userDisplay = document.getElementById('user-display');
    const storedUser = sessionStorage.getItem('oasis_admin_user');
    if (userDisplay && storedUser) {
      userDisplay.textContent = storedUser;
    }

    // Logout
    const btnLogout = document.getElementById('btn-logout');
    btnLogout?.addEventListener('click', () => {
      sessionStorage.removeItem('oasis_admin_authenticated');
      sessionStorage.removeItem('oasis_admin_user');
      window.location.href = '/admin/login';
    });

    // Elements
    const btnRefresh = document.getElementById('btn-refresh');
    const btnRetry = document.getElementById('btn-retry');
    const btnExport = document.getElementById('btn-export');
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const filterButtonsStore = document.querySelectorAll('.btn-filter-store');
    const filterButtonsStatus = document.querySelectorAll('.btn-filter-status');

    const loadingState = document.getElementById('loading-state');
    const errorState = document.getElementById('error-state');
    const errorMsgText = document.getElementById('error-msg-text');
    const emptyState = document.getElementById('empty-state');
    const tableContainer = document.getElementById('table-container');
    const tableBody = document.getElementById('table-body');

    const statTotal = document.getElementById('stat-total');
    const statMalabia = document.getElementById('stat-malabia');
    const statUnicenter = document.getElementById('stat-unicenter');
    const statProhibidos = document.getElementById('stat-prohibidos');

    // Ticket modal elements
    const ticketModal = document.getElementById('ticket-modal');
    const ticketModalTitle = document.getElementById('ticket-modal-title');
    const ticketModalSub = document.getElementById('ticket-modal-sub');
    const ticketViewerSlot = document.getElementById('ticket-viewer-slot');
    const ticketDownloadBtn = document.getElementById('btn-ticket-download') as HTMLAnchorElement | null;
    const btnTicketClose = document.getElementById('btn-ticket-modal-close');
    const ticketBackdrop = document.getElementById('modal-ticket-backdrop');

    // Ban modal elements
    const banModal = document.getElementById('ban-modal');
    const banModalTitle = document.getElementById('ban-modal-title');
    const banModalDesc = document.getElementById('ban-modal-desc');
    const btnCancelBan = document.getElementById('btn-cancel-ban');
    const btnConfirmBan = document.getElementById('btn-confirm-ban') as HTMLButtonElement | null;
    const banBackdrop = document.getElementById('modal-ban-backdrop');
    const banIconWrap = document.getElementById('ban-icon-wrap');
    const banIconSvg = document.getElementById('ban-icon-svg');

    let allRegistrations: Registration[] = [];
    let currentFilterStore: 'all' | 'malabia' | 'unicenter' = 'all';
    let currentFilterStatus: 'active' | 'prohibited' | 'all' = 'active';
    let currentSearchTerm = '';
    let pendingBanRegistration: Registration | null = null;

    async function loadData() {
      if (loadingState) loadingState.style.display = 'flex';
      if (errorState) errorState.style.display = 'none';
      if (emptyState) emptyState.style.display = 'none';
      if (tableContainer) tableContainer.style.display = 'none';

      try {
        const client = getSupabaseClient();
        const { data, error } = await client
          .from('oasis_registrations')
          .select('*')
          .order('created_at', { ascending: false });

        if (error) throw error;

        allRegistrations = (data || []) as Registration[];

        updateMetrics();
        renderTable();
      } catch (err: any) {
        console.error('[Dashboard fetch error]', err);
        if (loadingState) loadingState.style.display = 'none';
        if (errorState) {
          errorState.style.display = 'flex';
          if (errorMsgText) {
            errorMsgText.textContent = err.message || 'Error al conectar con Supabase.';
          }
        }
      }
    }

    function updateMetrics() {
      const total = allRegistrations.length;
      const malabiaCount = allRegistrations.filter((r) => r.tienda === 'malabia').length;
      const unicenterCount = allRegistrations.filter((r) => r.tienda === 'unicenter').length;
      const prohibidosCount = allRegistrations.filter((r) => Boolean(r.is_banned)).length;

      if (statTotal) statTotal.textContent = total.toString();
      if (statMalabia) statMalabia.textContent = malabiaCount.toString();
      if (statUnicenter) statUnicenter.textContent = unicenterCount.toString();
      if (statProhibidos) statProhibidos.textContent = prohibidosCount.toString();
    }

    function renderTable() {
      if (loadingState) loadingState.style.display = 'none';

      // Apply store, status, and search filters
      const filtered = allRegistrations.filter((item) => {
        const matchesStore = currentFilterStore === 'all' || item.tienda === currentFilterStore;
        
        let matchesStatus = true;
        if (currentFilterStatus === 'active') {
          matchesStatus = !item.is_banned;
        } else if (currentFilterStatus === 'prohibited') {
          matchesStatus = Boolean(item.is_banned);
        }

        const query = currentSearchTerm.toLowerCase();
        const matchesSearch =
          !query ||
          item.nombre.toLowerCase().includes(query) ||
          item.dni.toLowerCase().includes(query) ||
          item.telefono.toLowerCase().includes(query) ||
          item.email.toLowerCase().includes(query);

        return matchesStore && matchesStatus && matchesSearch;
      });

      if (filtered.length === 0) {
        if (tableContainer) tableContainer.style.display = 'none';
        if (emptyState) emptyState.style.display = 'flex';
        return;
      }

      if (emptyState) emptyState.style.display = 'none';
      if (tableContainer) tableContainer.style.display = 'block';

      if (tableBody) {
        tableBody.innerHTML = filtered
          .map((reg) => {
            const formattedDate = new Date(reg.created_at).toLocaleString('es-AR', {
              timeZone: 'America/Argentina/Buenos_Aires',
              day: '2-digit',
              month: '2-digit',
              year: 'numeric',
              hour: '2-digit',
              minute: '2-digit',
            });

            const storeBadgeClass = reg.tienda === 'malabia' ? 'store-badge-malabia' : 'store-badge-unicenter';
            const storeLabel = reg.tienda === 'malabia' ? 'MALABIA' : 'UNICENTER';
            const isBanned = Boolean(reg.is_banned);
            const rowClass = isBanned ? 'row-banned' : '';

            const banButtonHtml = isBanned
              ? `
                <button type="button" class="btn-ban-toggle btn-unban" data-action="toggle-ban" data-id="${reg.id}" title="Habilitar usuario">
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    <polyline points="9 12 11 14 15 10"></polyline>
                  </svg>
                  <span>HABILITAR</span>
                </button>
              `
              : `
                <button type="button" class="btn-ban-toggle btn-ban" data-action="toggle-ban" data-id="${reg.id}" title="Deshabilitar usuario">
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                  </svg>
                  <span>DESHABILITAR</span>
                </button>
              `;

            return `
              <tr data-id="${reg.id}" class="${rowClass}">
                <td style="white-space: nowrap; color: #888888; font-size: 0.88rem;">${formattedDate}</td>
                <td><span class="${storeBadgeClass}">${storeLabel}</span></td>
                <td style="font-weight: 600; color: #ffffff; font-size: 0.95rem;">${escapeHtml(reg.nombre)}</td>
                <td class="cell-dni">${escapeHtml(reg.dni)}</td>
                <td>
                  <div style="display: flex; flex-direction: column; gap: 0.2rem;">
                    <span class="contact-phone">${escapeHtml(reg.telefono)}</span>
                    <span class="contact-email">${escapeHtml(reg.email)}</span>
                  </div>
                </td>
                <td>
                  <button type="button" class="btn-view-ticket" data-action="view-ticket" data-id="${reg.id}">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                      <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <span>VER TICKET</span>
                  </button>
                </td>
                <td>
                  <input
                    type="text"
                    class="notes-input"
                    placeholder="Agregar nota..."
                    value="${escapeHtml(reg.admin_notes || '')}"
                    data-id="${reg.id}"
                  />
                </td>
                <td>
                  ${banButtonHtml}
                </td>
              </tr>
            `;
          })
          .join('');
      }

      // Attach dynamic listeners on rendered rows
      tableBody?.querySelectorAll('button[data-action="view-ticket"]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          const reg = allRegistrations.find((r) => r.id === id);
          if (reg) openTicketModal(reg);
        });
      });

      tableBody?.querySelectorAll('button[data-action="toggle-ban"]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          const reg = allRegistrations.find((r) => r.id === id);
          if (reg) openBanModal(reg);
        });
      });

      tableBody?.querySelectorAll('.notes-input').forEach((input) => {
        input.addEventListener('change', async (e) => {
          const target = e.target as HTMLInputElement;
          const id = target.getAttribute('data-id');
          const newNote = target.value.trim();
          if (id) {
            try {
              const client = getSupabaseClient();
              await client.from('oasis_registrations').update({ admin_notes: newNote }).eq('id', id);
              const found = allRegistrations.find((r) => r.id === id);
              if (found) found.admin_notes = newNote;
            } catch (err) {
              console.error('[Update notes error]', err);
            }
          }
        });
      });
    }

    function openTicketModal(reg: Registration) {
      if (!ticketModal || !ticketViewerSlot) return;

      if (ticketModalTitle) ticketModalTitle.textContent = `Ticket: ${reg.ticket_filename || reg.dni}`;
      if (ticketModalSub) ticketModalSub.textContent = `Titular: ${reg.nombre} · DNI: ${reg.dni} · ${reg.tienda === 'malabia' ? 'Malabia' : 'Unicenter'}`;

      if (ticketDownloadBtn) {
        ticketDownloadBtn.href = reg.ticket_url;
      }

      const isPdf = reg.ticket_url.toLowerCase().endsWith('.pdf') || reg.ticket_filename.toLowerCase().endsWith('.pdf');

      if (isPdf) {
        ticketViewerSlot.innerHTML = `<iframe src="${reg.ticket_url}" class="viewer-pdf" title="Comprobante PDF"></iframe>`;
      } else {
        ticketViewerSlot.innerHTML = `<img src="${reg.ticket_url}" alt="Comprobante de compra" class="viewer-image" />`;
      }

      ticketModal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function closeTicketModal() {
      if (ticketModal) {
        ticketModal.style.display = 'none';
        document.body.style.overflow = '';
      }
    }

    btnTicketClose?.addEventListener('click', closeTicketModal);
    ticketBackdrop?.addEventListener('click', closeTicketModal);

    function openBanModal(reg: Registration) {
      pendingBanRegistration = reg;
      const isBanned = Boolean(reg.is_banned);

      if (banModalTitle && banModalDesc && btnConfirmBan && banIconWrap) {
        if (isBanned) {
          banModalTitle.textContent = `¿HABILITAR A ${reg.nombre.toUpperCase()}?`;
          banModalDesc.textContent = `El registro de ${reg.nombre} (DNI: ${reg.dni}) volverá a estar HABILITADO y visible en la lista principal de participantes.`;
          btnConfirmBan.textContent = 'Habilitar Registro';
          btnConfirmBan.style.background = '#52c41a';
          btnConfirmBan.style.color = '#000000';
          banIconWrap.style.background = 'rgba(82, 196, 26, 0.12)';
          banIconWrap.style.borderColor = 'rgba(82, 196, 26, 0.3)';
          if (banIconSvg) banIconSvg.setAttribute('stroke', '#52c41a');
        } else {
          banModalTitle.textContent = `¿DESHABILITAR A ${reg.nombre.toUpperCase()}?`;
          banModalDesc.textContent = `El usuario quedará marcado como NO HABILITADO. Sus datos (DNI: ${reg.dni}) permanecerán en la base de datos para impedir que vuelva a registrarse en el formulario.`;
          btnConfirmBan.textContent = 'Confirmar Deshabilitación';
          btnConfirmBan.style.background = '#ff4d4f';
          btnConfirmBan.style.color = '#ffffff';
          banIconWrap.style.background = 'rgba(255, 77, 79, 0.12)';
          banIconWrap.style.borderColor = 'rgba(255, 77, 79, 0.3)';
          if (banIconSvg) banIconSvg.setAttribute('stroke', '#ff4d4f');
        }
      }

      if (banModal) {
        banModal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }
    }

    function closeBanModal() {
      pendingBanRegistration = null;
      if (banModal) {
        banModal.style.display = 'none';
        document.body.style.overflow = '';
      }
    }

    btnCancelBan?.addEventListener('click', closeBanModal);
    banBackdrop?.addEventListener('click', closeBanModal);

    btnConfirmBan?.addEventListener('click', async () => {
      if (!pendingBanRegistration || !btnConfirmBan) return;
      const reg = pendingBanRegistration;
      const newBannedState = !reg.is_banned;

      btnConfirmBan.textContent = newBannedState ? 'Deshabilitando...' : 'Habilitando...';
      btnConfirmBan.setAttribute('disabled', 'true');

      try {
        const client = getSupabaseClient();
        const { error: dbError } = await client
          .from('oasis_registrations')
          .update({ is_banned: newBannedState })
          .eq('id', reg.id);

        if (dbError) throw dbError;

        // Update local state
        reg.is_banned = newBannedState;
        updateMetrics();
        renderTable();
        closeBanModal();
      } catch (err: any) {
        alert('Error al actualizar estado: ' + (err.message || 'Error desconocido'));
      } finally {
        btnConfirmBan.removeAttribute('disabled');
      }
    });

    // Search and Filters
    searchInput?.addEventListener('input', (e) => {
      currentSearchTerm = (e.target as HTMLInputElement).value;
      renderTable();
    });

    filterButtonsStore.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtonsStore.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentFilterStore = (btn.getAttribute('data-store') || 'all') as 'all' | 'malabia' | 'unicenter';
        renderTable();
      });
    });

    filterButtonsStatus.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtonsStatus.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentFilterStatus = (btn.getAttribute('data-status') || 'active') as 'active' | 'prohibited' | 'all';
        renderTable();
      });
    });

    btnRefresh?.addEventListener('click', () => {
      loadData();
    });
    btnRetry?.addEventListener('click', () => {
      loadData();
    });

    // Export to CSV
    btnExport?.addEventListener('click', () => {
      if (allRegistrations.length === 0) {
        alert('No hay registros para exportar.');
        return;
      }

      const headers = ['ID', 'Fecha (GMT-3)', 'Tienda', 'Nombre', 'DNI', 'Telefono', 'Email', 'Ticket URL', 'Notas Admin', 'Estado'];
      const rows = allRegistrations.map((r) => {
        let formattedDate = r.created_at;
        try {
          formattedDate = new Date(r.created_at).toLocaleString('es-AR', {
            timeZone: 'America/Argentina/Buenos_Aires',
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            hour12: false,
          });
        } catch {
          formattedDate = r.created_at;
        }

        return [
          r.id,
          `"${formattedDate}"`,
          r.tienda,
          `"${r.nombre.replace(/"/g, '""')}"`,
          `"${r.dni}"`,
          `"${r.telefono}"`,
          `"${r.email}"`,
          `"${r.ticket_url}"`,
          `"${(r.admin_notes || '').replace(/"/g, '""')}"`,
          `"${r.is_banned ? 'NO HABILITADO' : 'HABILITADO'}"`,
        ];
      });

      const csvContent = '\uFEFF' + [headers.join(','), ...rows.map((row) => row.join(','))].join('\n');
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.setAttribute('href', url);
      link.setAttribute('download', `oasis_registros_${new Date().toISOString().slice(0, 10)}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });

    function escapeHtml(str: string) {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // Initial load
    loadData();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDashboard);
  } else {
    initDashboard();
  }
</script>
