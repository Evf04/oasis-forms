---
// src/pages/admin/dashboard.astro
import Layout from "../../layouts/Layout.astro";
---

<Layout title="OASIS | Admin Dashboard" description="Panel de gestión y validación de comprobantes OASIS | Adidas">
  <!-- Strict Authentication Guard - Blocks unauthenticated visitors before render -->
  <script is:inline>
    (function () {
      if (typeof window !== 'undefined') {
        const isAuth = sessionStorage.getItem('oasis_admin_authenticated');
        if (isAuth !== 'true') {
          window.location.replace('/admin/login');
        }
      }
    })();
  </script>

  <div class="dashboard-page" id="dashboard-app" style="display: none;">
    <!-- Top Navigation Bar -->
    <header class="dash-navbar">
      <div class="dash-nav-container">
        <div class="dash-brand">
          <img src="/images/adidas.svg" alt="adidas" width="60" height="42" class="dash-logo" />
          <span class="dash-logo-divider"></span>
          <img src="/images/oasis.svg" alt="Oasis" width="100" height="40" class="dash-logo" />
          <span class="dash-badge">ADMIN DASHBOARD</span>
        </div>

        <div class="dash-user-controls">
          <div class="user-pill">
            <span class="user-indicator"></span>
            <span class="user-name" id="user-display">admin</span>
          </div>
          <button type="button" class="btn-logout" id="btn-logout" title="Cerrar sesión">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            <span>Cerrar Sesión</span>
          </button>
        </div>
      </div>
    </header>

    <main class="dash-main">
      <div class="dash-content-container">
        <!-- Dashboard Header & Stats -->
        <div class="dash-header">
          <div>
            <h1 class="dash-title">REGISTROS DE COMPROBANTES</h1>
            <p class="dash-subtitle">Visualizá, validá comprobantes y administrá la base de datos en tiempo real</p>
          </div>

          <div class="header-actions">
            <button type="button" class="btn-tool btn-refresh" id="btn-refresh" title="Recargar lista de registros">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" id="refresh-icon">
                <path d="M23 4v6h-6"></path>
                <path d="M1 20v-6h6"></path>
                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
              </svg>
              <span>Actualizar</span>
            </button>
            <button type="button" class="btn-tool btn-export" id="btn-export" title="Exportar registros a archivo CSV">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Exportar CSV</span>
            </button>
          </div>
        </div>

        <!-- Metric KPI Cards -->
        <div class="metrics-grid">
          <div class="metric-card">
            <span class="metric-label">TOTAL REGISTROS</span>
            <span class="metric-value" id="stat-total">0</span>
          </div>
          <div class="metric-card">
            <span class="metric-label">ORIGINALS MALABIA</span>
            <span class="metric-value" id="stat-malabia">0</span>
          </div>
          <div class="metric-card">
            <span class="metric-label">ORIGINALS UNICENTER</span>
            <span class="metric-value" id="stat-unicenter">0</span>
          </div>
        </div>

        <!-- Filters and Search Toolbar -->
        <div class="toolbar">
          <div class="search-box">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" class="search-icon">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="text"
              id="search-input"
              placeholder="Buscar por Nombre, DNI, Teléfono o Email..."
              class="search-input"
            />
          </div>

          <div class="filter-group">
            <span class="filter-label">Tienda:</span>
            <div class="filter-buttons">
              <button type="button" class="btn-filter active" data-store="all">Todas</button>
              <button type="button" class="btn-filter" data-store="malabia">Malabia</button>
              <button type="button" class="btn-filter" data-store="unicenter">Unicenter</button>
            </div>
          </div>
        </div>

        <!-- Loading State -->
        <div class="loading-state" id="loading-state">
          <svg viewBox="0 0 24 24" width="32" height="32" stroke="currentColor" fill="none" stroke-width="2.5" class="spin-icon">
            <circle cx="12" cy="12" r="10" stroke-dasharray="32" stroke-dashoffset="12"></circle>
          </svg>
          <span>Cargando registros de la base de datos...</span>
        </div>

        <!-- Error State -->
        <div class="error-state" id="error-state" style="display: none;">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#ff4d4f" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <span id="error-msg-text">Ocurrió un error al consultar Supabase.</span>
          <button type="button" class="btn-retry" id="btn-retry">Reintentar</button>
        </div>

        <!-- Empty State -->
        <div class="empty-state" id="empty-state" style="display: none;">
          <div class="empty-icon-wrap">
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
          </div>
          <h3>No se encontraron registros</h3>
          <p>Los tickets cargados por los usuarios aparecerán en esta tabla en tiempo real.</p>
        </div>

        <!-- Table Container -->
        <div class="table-container" id="table-container" style="display: none;">
          <table class="dash-table">
            <thead>
              <tr>
                <th>Fecha</th>
                <th>Tienda</th>
                <th>Titular</th>
                <th>DNI</th>
                <th>Contacto</th>
                <th>Comprobante</th>
                <th>Notas Admin</th>
                <th>Acción</th>
              </tr>
            </thead>
            <tbody id="table-body">
              <!-- Dynamically rendered -->
            </tbody>
          </table>
        </div>
      </div>
    </main>

    <!-- Ticket Viewer Modal -->
    <div class="modal-viewer" id="ticket-modal" style="display: none;" role="dialog" aria-modal="true">
      <div class="modal-viewer-backdrop" id="modal-ticket-backdrop"></div>
      <div class="modal-viewer-content">
        <div class="modal-viewer-header">
          <div>
            <h2 class="modal-viewer-title" id="ticket-modal-title">Comprobante de Compra</h2>
            <span class="modal-viewer-sub" id="ticket-modal-sub">Titular: -</span>
          </div>
          <button type="button" class="btn-modal-x" id="btn-ticket-modal-close" aria-label="Cerrar visor">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <div class="modal-viewer-body" id="ticket-viewer-slot">
          <!-- Dynamically populated with media element -->
        </div>

        <div class="modal-viewer-footer">
          <a href="#" target="_blank" rel="noopener noreferrer" class="btn-download" id="btn-ticket-download">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Abrir en tamaño original</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal-delete" id="delete-modal" style="display: none;" role="dialog" aria-modal="true">
      <div class="modal-delete-backdrop" id="modal-delete-backdrop"></div>
      <div class="modal-delete-card">
        <div class="delete-icon-wrap">
          <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="#ff4d4f" stroke-width="2.2">
            <path d="M3 6h18"></path>
            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            <line x1="10" y1="11" x2="10" y2="17"></line>
            <line x1="14" y1="11" x2="14" y2="17"></line>
          </svg>
        </div>
        <h3 class="delete-title">¿Eliminar este registro?</h3>
        <p class="delete-desc" id="delete-desc">Esta acción eliminará el registro de la base de datos y el comprobante del servidor permanentemente.</p>
        <div class="delete-actions">
          <button type="button" class="btn-cancel" id="btn-cancel-delete">Cancelar</button>
          <button type="button" class="btn-confirm-delete" id="btn-confirm-delete">Eliminar definitivamente</button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .dashboard-page {
    min-height: 100vh;
    min-height: 100dvh;
    background-color: #050505;
    color: var(--text-primary);
    display: flex;
    flex-direction: column;
  }

  /* Navbar */
  .dash-navbar {
    background-color: #000000;
    border-bottom: 1.5px solid #222222;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .dash-nav-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0.85rem clamp(1rem, 3vw, 2rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .dash-brand {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .dash-logo {
    height: auto;
    object-fit: contain;
  }

  .dash-logo-divider {
    width: 2px;
    height: 28px;
    background-color: #ffffff;
    opacity: 0.85;
  }

  .dash-badge {
    background: #1a1a1a;
    border: 1px solid #3d3d3d;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: #ffffff;
  }

  .dash-user-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .user-pill {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #111111;
    border: 1px solid #333333;
    padding: 0.4rem 0.85rem;
    border-radius: 20px;
    font-size: 0.88rem;
  }

  .user-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #22c55e;
    box-shadow: 0 0 8px rgba(34, 197, 94, 0.6);
  }

  .user-name {
    font-weight: 600;
  }

  .btn-logout {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: transparent;
    border: 1px solid #444444;
    color: #cccccc;
    padding: 0.45rem 0.95rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    font-size: 0.88rem;
    transition: all var(--transition-fast);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-logout:hover {
      background: #1a1a1a;
      color: #ff4d4f;
      border-color: #ff4d4f;
    }
  }

  /* Main Container */
  .dash-main {
    flex-grow: 1;
    padding: clamp(1.5rem, 3vw, 2.5rem) 1rem;
  }

  .dash-content-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  /* Header */
  .dash-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .dash-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 2.3rem);
    letter-spacing: 0.03em;
    color: var(--text-primary);
    text-transform: uppercase;
    line-height: 1.1;
    margin-bottom: 0.35rem;
  }

  .dash-subtitle {
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .header-actions {
    display: flex;
    gap: 0.75rem;
  }

  .btn-tool {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #141414;
    border: 1.5px solid #333333;
    color: #ffffff;
    padding: 0.65rem 1.15rem;
    border-radius: var(--radius-md);
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.03em;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-tool:hover {
      background: #222222;
      border-color: #666666;
    }
  }

  .btn-export {
    background-color: var(--accent-white);
    color: var(--text-inverted);
    border-color: var(--accent-white);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-export:hover {
      background-color: #e0e0e0;
    }
  }

  /* Metrics Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }

  .metric-card {
    background: #0d0d0d;
    border: 1.5px solid #222222;
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .metric-label {
    font-family: var(--font-display);
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
  }

  .metric-value {
    font-family: var(--font-display);
    font-size: 2.2rem;
    color: var(--text-primary);
    line-height: 1;
  }

  /* Toolbar */
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: #0d0d0d;
    border: 1.5px solid #222222;
    border-radius: var(--radius-md);
    padding: 0.85rem 1.25rem;
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1;
    min-width: 280px;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    color: #666666;
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    background: #000000;
    border: 1.5px solid #333333;
    border-radius: var(--radius-sm);
    padding: 0.7rem 1rem 0.7rem 2.75rem;
    color: var(--text-primary);
    font-size: 0.95rem;
  }

  .search-input:focus {
    border-color: var(--accent-white);
    outline: none;
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .filter-label {
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .filter-buttons {
    display: flex;
    gap: 0.35rem;
  }

  .btn-filter {
    background: #141414;
    border: 1px solid #333333;
    color: #888888;
    padding: 0.45rem 0.85rem;
    border-radius: 4px;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .btn-filter.active {
    background: #ffffff;
    color: #000000;
    border-color: #ffffff;
    font-weight: 600;
  }

  /* Table */
  .table-container {
    background: #0d0d0d;
    border: 1.5px solid #222222;
    border-radius: var(--radius-md);
    overflow-x: auto;
  }

  .dash-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    min-width: 960px;
  }

  .dash-table th {
    background: #141414;
    color: #aaaaaa;
    font-family: var(--font-display);
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    padding: 1rem 1.15rem;
    border-bottom: 1.5px solid #222222;
    text-transform: uppercase;
  }

  :global(.dash-table td) {
    padding: 1rem 1.15rem;
    border-bottom: 1px solid #1a1a1a;
    font-size: 0.95rem;
    vertical-align: middle;
  }

  :global(.dash-table tr:hover td) {
    background: #111111;
  }

  :global(.store-tag) {
    display: inline-block;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  :global(.store-malabia) {
    background: rgba(59, 130, 246, 0.15);
    color: #60a5fa;
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  :global(.store-unicenter) {
    background: rgba(168, 85, 247, 0.15);
    color: #c084fc;
    border: 1px solid rgba(168, 85, 247, 0.3);
  }

  :global(.btn-view-ticket) {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: #1a1a1a;
    border: 1px solid #444444;
    color: #ffffff;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  :global(.btn-view-ticket:hover) {
    background: #ffffff;
    color: #000000;
    border-color: #ffffff;
  }

  :global(.btn-delete-row) {
    background: transparent;
    border: none;
    color: #666666;
    cursor: pointer;
    padding: 0.45rem;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
  }

  :global(.btn-delete-row:hover) {
    background: rgba(255, 77, 79, 0.15);
    color: #ff4d4f;
  }

  :global(.notes-input) {
    background: #000000;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 0.35rem 0.65rem;
    color: #cccccc;
    font-size: 0.85rem;
    width: 100%;
    max-width: 180px;
  }

  :global(.notes-input:focus) {
    border-color: #888888;
    outline: none;
    color: #ffffff;
  }

  /* States */
  .loading-state, .error-state, .empty-state {
    background: #0d0d0d;
    border: 1.5px solid #222222;
    border-radius: var(--radius-md);
    padding: 4rem 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    color: var(--text-secondary);
  }

  .empty-icon-wrap {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: #141414;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid #333333;
  }

  .spin-icon {
    animation: spin 0.8s linear infinite;
  }

  .btn-retry {
    background: #ffffff;
    color: #000000;
    border: none;
    padding: 0.6rem 1.25rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    font-weight: 600;
  }

  /* Modals */
  .modal-viewer, .modal-delete {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 1rem;
  }

  .modal-viewer-backdrop, .modal-delete-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(6px);
  }

  .modal-viewer-content {
    position: relative;
    z-index: 10;
    background: #111111;
    border: 1.5px solid #333333;
    border-radius: var(--radius-lg);
    max-width: min(850px, 95vw);
    width: 100%;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.95);
  }

  .modal-viewer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1.5px solid #222222;
  }

  .modal-viewer-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    letter-spacing: 0.03em;
    color: #ffffff;
  }

  .modal-viewer-sub {
    font-size: 0.85rem;
    color: #888888;
  }

  .btn-modal-x {
    background: transparent;
    border: none;
    color: #aaaaaa;
    cursor: pointer;
    padding: 0.4rem;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .btn-modal-x:hover {
    color: #ffffff;
    background: #222222;
  }

  .modal-viewer-body {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #080808;
    min-height: 380px;
  }

  :global(.viewer-image) {
    max-width: 100%;
    max-height: 65vh;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.8);
  }

  :global(.viewer-pdf) {
    width: 100%;
    height: 65vh;
    border: none;
    border-radius: 4px;
  }

  .modal-viewer-footer {
    padding: 1rem 1.5rem;
    border-top: 1.5px solid #222222;
    display: flex;
    justify-content: flex-end;
  }

  .btn-download {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #ffffff;
    color: #000000;
    padding: 0.65rem 1.25rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
  }

  /* Delete Modal */
  .modal-delete-card {
    position: relative;
    z-index: 10;
    background: #111111;
    border: 1.5px solid #333333;
    border-radius: var(--radius-lg);
    max-width: 440px;
    width: 100%;
    padding: 2rem;
    text-align: center;
  }

  .delete-icon-wrap {
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: rgba(255, 77, 79, 0.12);
    border: 1.5px solid rgba(255, 77, 79, 0.3);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .delete-title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: #ffffff;
    margin-bottom: 0.5rem;
  }

  .delete-desc {
    font-size: 0.92rem;
    color: #888888;
    line-height: 1.45;
    margin-bottom: 1.75rem;
  }

  .delete-actions {
    display: flex;
    gap: 0.85rem;
  }

  .btn-cancel {
    flex: 1;
    min-height: 48px;
    background: #1c1c1c;
    border: 1px solid #444444;
    color: #ffffff;
    border-radius: var(--radius-md);
    cursor: pointer;
    font-weight: 600;
  }

  .btn-confirm-delete {
    flex: 1;
    min-height: 48px;
    background: #ff4d4f;
    border: none;
    color: #ffffff;
    border-radius: var(--radius-md);
    cursor: pointer;
    font-weight: 600;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @media (max-width: 768px) {
    .dash-navbar {
      position: relative;
    }
    .dash-nav-container {
      flex-direction: column;
      align-items: flex-start;
    }
    .dash-user-controls {
      width: 100%;
      justify-content: space-between;
    }
    .header-actions {
      width: 100%;
    }
    .btn-tool {
      flex: 1;
      justify-content: center;
    }
  }
</style>

<script>
  import { getSupabaseClient } from '../../lib/supabase';

  interface Registration {
    id: string;
    tienda: 'malabia' | 'unicenter';
    nombre: string;
    dni: string;
    telefono: string;
    email: string;
    ticket_url: string;
    ticket_filename: string;
    ticket_size_bytes: number;
    admin_notes: string | null;
    created_at: string;
  }

  function initDashboard() {
    // 1. Guard check
    const isAuth = sessionStorage.getItem('oasis_admin_authenticated');
    if (isAuth !== 'true') {
      window.location.replace('/admin/login');
      return;
    }

    const app = document.getElementById('dashboard-app');
    if (app) app.style.display = 'flex';

    const userDisplay = document.getElementById('user-display');
    const storedUser = sessionStorage.getItem('oasis_admin_user');
    if (userDisplay && storedUser) {
      userDisplay.textContent = storedUser;
    }

    // Logout
    const btnLogout = document.getElementById('btn-logout');
    btnLogout?.addEventListener('click', () => {
      sessionStorage.removeItem('oasis_admin_authenticated');
      sessionStorage.removeItem('oasis_admin_user');
      window.location.href = '/admin/login';
    });

    // Elements
    const btnRefresh = document.getElementById('btn-refresh');
    const btnRetry = document.getElementById('btn-retry');
    const btnExport = document.getElementById('btn-export');
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const filterButtons = document.querySelectorAll('.btn-filter');

    const loadingState = document.getElementById('loading-state');
    const errorState = document.getElementById('error-state');
    const errorMsgText = document.getElementById('error-msg-text');
    const emptyState = document.getElementById('empty-state');
    const tableContainer = document.getElementById('table-container');
    const tableBody = document.getElementById('table-body');

    const statTotal = document.getElementById('stat-total');
    const statMalabia = document.getElementById('stat-malabia');
    const statUnicenter = document.getElementById('stat-unicenter');

    // Ticket modal elements
    const ticketModal = document.getElementById('ticket-modal');
    const ticketModalTitle = document.getElementById('ticket-modal-title');
    const ticketModalSub = document.getElementById('ticket-modal-sub');
    const ticketViewerSlot = document.getElementById('ticket-viewer-slot');
    const ticketDownloadBtn = document.getElementById('btn-ticket-download') as HTMLAnchorElement | null;
    const btnTicketClose = document.getElementById('btn-ticket-modal-close');
    const ticketBackdrop = document.getElementById('modal-ticket-backdrop');

    // Delete modal elements
    const deleteModal = document.getElementById('delete-modal');
    const deleteDesc = document.getElementById('delete-desc');
    const btnCancelDelete = document.getElementById('btn-cancel-delete');
    const btnConfirmDelete = document.getElementById('btn-confirm-delete');
    const deleteBackdrop = document.getElementById('modal-delete-backdrop');

    let allRegistrations: Registration[] = [];
    let currentFilterStore: 'all' | 'malabia' | 'unicenter' = 'all';
    let currentSearchTerm = '';
    let pendingDeleteRegistration: Registration | null = null;

    async function loadData() {
      if (loadingState) loadingState.style.display = 'flex';
      if (errorState) errorState.style.display = 'none';
      if (emptyState) emptyState.style.display = 'none';
      if (tableContainer) tableContainer.style.display = 'none';

      try {
        const client = getSupabaseClient();
        const { data, error } = await client
          .from('oasis_registrations')
          .select('*')
          .order('created_at', { ascending: false });

        if (error) throw error;

        allRegistrations = (data || []) as Registration[];

        updateMetrics();
        renderTable();
      } catch (err: any) {
        console.error('[Dashboard fetch error]', err);
        if (loadingState) loadingState.style.display = 'none';
        if (errorState) {
          errorState.style.display = 'flex';
          if (errorMsgText) {
            errorMsgText.textContent = err.message || 'Error al conectar con Supabase.';
          }
        }
      }
    }

    function updateMetrics() {
      const total = allRegistrations.length;
      const malabiaCount = allRegistrations.filter((r) => r.tienda === 'malabia').length;
      const unicenterCount = allRegistrations.filter((r) => r.tienda === 'unicenter').length;

      if (statTotal) statTotal.textContent = total.toString();
      if (statMalabia) statMalabia.textContent = malabiaCount.toString();
      if (statUnicenter) statUnicenter.textContent = unicenterCount.toString();
    }

    function renderTable() {
      if (loadingState) loadingState.style.display = 'none';

      // Apply filter and search
      const filtered = allRegistrations.filter((item) => {
        const matchesStore = currentFilterStore === 'all' || item.tienda === currentFilterStore;
        const query = currentSearchTerm.toLowerCase();
        const matchesSearch =
          !query ||
          item.nombre.toLowerCase().includes(query) ||
          item.dni.toLowerCase().includes(query) ||
          item.telefono.toLowerCase().includes(query) ||
          item.email.toLowerCase().includes(query);

        return matchesStore && matchesSearch;
      });

      if (filtered.length === 0) {
        if (tableContainer) tableContainer.style.display = 'none';
        if (emptyState) emptyState.style.display = 'flex';
        return;
      }

      if (emptyState) emptyState.style.display = 'none';
      if (tableContainer) tableContainer.style.display = 'block';

      if (tableBody) {
        tableBody.innerHTML = filtered
          .map((reg) => {
            const formattedDate = new Date(reg.created_at).toLocaleString('es-AR', {
              day: '2-digit',
              month: '2-digit',
              year: 'numeric',
              hour: '2-digit',
              minute: '2-digit',
            });

            const storeClass = reg.tienda === 'malabia' ? 'store-malabia' : 'store-unicenter';
            const storeLabel = reg.tienda === 'malabia' ? 'Malabia' : 'Unicenter';

            return `
              <tr data-id="${reg.id}">
                <td style="white-space: nowrap; color: #888888; font-size: 0.88rem;">${formattedDate}</td>
                <td><span class="store-tag ${storeClass}">${storeLabel}</span></td>
                <td style="font-weight: 600; color: #ffffff;">${escapeHtml(reg.nombre)}</td>
                <td style="font-family: monospace; font-size: 0.95rem;">${escapeHtml(reg.dni)}</td>
                <td>
                  <div style="display: flex; flex-direction: column; gap: 0.2rem; font-size: 0.88rem;">
                    <span>${escapeHtml(reg.telefono)}</span>
                    <span style="color: #888888;">${escapeHtml(reg.email)}</span>
                  </div>
                </td>
                <td>
                  <button type="button" class="btn-view-ticket" data-action="view-ticket" data-id="${reg.id}">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                      <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <span>Ver Ticket</span>
                  </button>
                </td>
                <td>
                  <input
                    type="text"
                    class="notes-input"
                    placeholder="Agregar nota..."
                    value="${escapeHtml(reg.admin_notes || '')}"
                    data-id="${reg.id}"
                  />
                </td>
                <td>
                  <button type="button" class="btn-delete-row" data-action="delete" data-id="${reg.id}" title="Eliminar registro">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="3 6 5 6 21 6"></polyline>
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                  </button>
                </td>
              </tr>
            `;
          })
          .join('');
      }

      // Attach dynamic listeners on rendered rows
      tableBody?.querySelectorAll('button[data-action="view-ticket"]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          const reg = allRegistrations.find((r) => r.id === id);
          if (reg) openTicketModal(reg);
        });
      });

      tableBody?.querySelectorAll('button[data-action="delete"]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          const reg = allRegistrations.find((r) => r.id === id);
          if (reg) openDeleteModal(reg);
        });
      });

      tableBody?.querySelectorAll('.notes-input').forEach((input) => {
        input.addEventListener('change', async (e) => {
          const target = e.target as HTMLInputElement;
          const id = target.getAttribute('data-id');
          const newNote = target.value.trim();
          if (id) {
            try {
              const client = getSupabaseClient();
              await client.from('oasis_registrations').update({ admin_notes: newNote }).eq('id', id);
              const found = allRegistrations.find((r) => r.id === id);
              if (found) found.admin_notes = newNote;
            } catch (err) {
              console.error('[Update notes error]', err);
            }
          }
        });
      });
    }

    function openTicketModal(reg: Registration) {
      if (!ticketModal || !ticketViewerSlot) return;

      if (ticketModalTitle) ticketModalTitle.textContent = `Ticket: ${reg.ticket_filename || reg.dni}`;
      if (ticketModalSub) ticketModalSub.textContent = `Titular: ${reg.nombre} · DNI: ${reg.dni} · ${reg.tienda === 'malabia' ? 'Malabia' : 'Unicenter'}`;

      if (ticketDownloadBtn) {
        ticketDownloadBtn.href = reg.ticket_url;
      }

      const isPdf = reg.ticket_url.toLowerCase().endsWith('.pdf') || reg.ticket_filename.toLowerCase().endsWith('.pdf');

      if (isPdf) {
        ticketViewerSlot.innerHTML = `<iframe src="${reg.ticket_url}" class="viewer-pdf" title="Comprobante PDF"></iframe>`;
      } else {
        ticketViewerSlot.innerHTML = `<img src="${reg.ticket_url}" alt="Comprobante de compra" class="viewer-image" />`;
      }

      ticketModal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function closeTicketModal() {
      if (ticketModal) {
        ticketModal.style.display = 'none';
        document.body.style.overflow = '';
      }
    }

    btnTicketClose?.addEventListener('click', closeTicketModal);
    ticketBackdrop?.addEventListener('click', closeTicketModal);

    function openDeleteModal(reg: Registration) {
      pendingDeleteRegistration = reg;
      if (deleteDesc) {
        deleteDesc.textContent = `¿Estás seguro de eliminar el registro de ${reg.nombre} (DNI: ${reg.dni})?`;
      }
      if (deleteModal) {
        deleteModal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }
    }

    function closeDeleteModal() {
      pendingDeleteRegistration = null;
      if (deleteModal) {
        deleteModal.style.display = 'none';
        document.body.style.overflow = '';
      }
    }

    btnCancelDelete?.addEventListener('click', closeDeleteModal);
    deleteBackdrop?.addEventListener('click', closeDeleteModal);

    btnConfirmDelete?.addEventListener('click', async () => {
      if (!pendingDeleteRegistration) return;
      const reg = pendingDeleteRegistration;

      btnConfirmDelete.textContent = 'Eliminando...';
      btnConfirmDelete.setAttribute('disabled', 'true');

      try {
        const client = getSupabaseClient();

        // 1. Delete from database
        const { error: dbError } = await client.from('oasis_registrations').delete().eq('id', reg.id);
        if (dbError) throw dbError;

        // 2. Delete from storage if filename exists
        if (reg.ticket_filename) {
          try {
            await client.storage.from('tickets').remove([reg.ticket_filename]);
          } catch (storageErr) {
            console.warn('[Storage remove warning]', storageErr);
          }
        }

        // Update local state
        allRegistrations = allRegistrations.filter((r) => r.id !== reg.id);
        updateMetrics();
        renderTable();
        closeDeleteModal();
      } catch (err: any) {
        alert('Error al eliminar registro: ' + (err.message || 'Error desconocido'));
      } finally {
        btnConfirmDelete.textContent = 'Eliminar definitivamente';
        btnConfirmDelete.removeAttribute('disabled');
      }
    });

    // Search and Filters
    searchInput?.addEventListener('input', (e) => {
      currentSearchTerm = (e.target as HTMLInputElement).value;
      renderTable();
    });

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentFilterStore = (btn.getAttribute('data-store') || 'all') as 'all' | 'malabia' | 'unicenter';
        renderTable();
      });
    });

    btnRefresh?.addEventListener('click', () => {
      loadData();
    });
    btnRetry?.addEventListener('click', () => {
      loadData();
    });

    // Export to CSV
    btnExport?.addEventListener('click', () => {
      if (allRegistrations.length === 0) {
        alert('No hay registros para exportar.');
        return;
      }

      const headers = ['ID', 'Fecha', 'Tienda', 'Nombre', 'DNI', 'Telefono', 'Email', 'Ticket URL', 'Notas Admin'];
      const rows = allRegistrations.map((r) => [
        r.id,
        new Date(r.created_at).toISOString(),
        r.tienda,
        `"${r.nombre.replace(/"/g, '""')}"`,
        `"${r.dni}"`,
        `"${r.telefono}"`,
        `"${r.email}"`,
        `"${r.ticket_url}"`,
        `"${(r.admin_notes || '').replace(/"/g, '""')}"`,
      ]);

      const csvContent = '\uFEFF' + [headers.join(','), ...rows.map((row) => row.join(','))].join('\n');
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.setAttribute('href', url);
      link.setAttribute('download', `oasis_registros_${new Date().toISOString().slice(0, 10)}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });

    function escapeHtml(str: string) {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // Initial load
    loadData();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDashboard);
  } else {
    initDashboard();
  }
</script>
